# Parameter configuration for Eidokali image build

# Output image name, usually same as repo name
IMAGE_NAME=eidokali

# Make this the same as your github username/organisation
REPO_ORGANIZATION="zyell"

IMAGE_DESC="Eidokali bootc image based on Universal Blue Bluefin-DX with COSMIC desktop and Proton Suite"
IMAGE_KEYWORDS="bootc,ublue,universal-blue,cosmic,fedora"

# Image URL for ArtifactHub
IMAGE_LOGO_URL="https://github.com/Zyell/Eidokali/blob/main/assets/kali.png?raw=true"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
